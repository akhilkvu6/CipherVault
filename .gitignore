# ==============================================================================
# CipherVault Authoritative .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.local
.env.*
*.jks
*.keystore

# Android Build Outputs & Caches
android/build/
android/app/build/
.gradle/
android/.gradle/
.externalNativeBuild/
.cxx/
captures/
*.class

# Android Local Machine Configuration (Preserves local SDK paths)
local.properties
android/local.properties

# Backend Maven Build Outputs & Runtime Storage
backend/target/
backend/storage/
storage/

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# IDE & Editor Configuration
.idea/
android/.idea/
*.iml
*.iws
*.ipr
.vscode/

# Logs, Dumps & Scratch Files
*.log
*.tmp
server-control/logs/
backend/scratch/
scratch/
tunnel.log

# Operating System Metadata
.DS_Store
Thumbs.db
Desktop.ini
