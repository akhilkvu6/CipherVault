<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ================================================================= -->
    <!-- CIPHERVAULT UNIFIED MATERIAL 3 THEME (DARK)                       -->
    <!-- Warm Brown / Taupe / Caramel / Cream Security Identity            -->
    <!-- ================================================================= -->
    <style name="Theme.CipherVault" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Accent Colors -->
        <item name="colorPrimary">@color/cv_dark_caramel</item>
        <item name="colorOnPrimary">@color/cv_dark_bg</item>
        <item name="colorPrimaryContainer">@color/cv_dark_surface_elevated</item>
        <item name="colorOnPrimaryContainer">@color/cv_dark_cream</item>

        <item name="colorSecondary">@color/cv_dark_primary_brown</item>
        <item name="colorOnSecondary">@color/cv_dark_text_primary</item>
        <item name="colorSecondaryContainer">@color/cv_dark_surface_container</item>
        <item name="colorOnSecondaryContainer">@color/cv_dark_cream</item>

        <!-- Surface Roles -->
        <item name="android:colorBackground">@color/cv_dark_bg</item>
        <item name="colorSurface">@color/cv_dark_bg</item>
        <item name="colorOnSurface">@color/cv_dark_text_primary</item>
        <item name="colorSurfaceVariant">@color/cv_dark_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/cv_dark_text_secondary</item>
        <item name="colorSurfaceContainer">@color/cv_dark_surface</item>
        <item name="colorSurfaceContainerLow">@color/cv_dark_surface</item>
        <item name="colorSurfaceContainerHigh">@color/cv_dark_surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/cv_dark_deep_brown</item>

        <!-- Outlines & Borders -->
        <item name="colorOutline">@color/cv_dark_outline</item>
        <item name="colorOutlineVariant">@color/cv_dark_outline_variant</item>

        <!-- Semantic Statuses -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/status_error_container</item>

        <!-- System Bars (Edge-to-Edge) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Material 3 Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CipherVault.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CipherVault.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CipherVault.Large</item>
        <item name="bottomSheetDialogTheme">@style/Theme.CipherVault.BottomSheetDialog</item>
    </style>

    <style name="Widget.CipherVault.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.CipherVault.BottomSheet</item>
        <item name="backgroundTint">@color/cv_dark_surface</item>
    </style>
</resources>