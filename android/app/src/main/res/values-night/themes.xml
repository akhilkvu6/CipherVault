<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Theme inheriting from Material 3 DayNight -->
    <style name="Theme.CipherVault" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Surface Roles -->
        <item name="colorSurface">@color/vault_bg_dark</item>
        <item name="colorOnSurface">@color/vault_text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/vault_surface_high_dark</item>
        <item name="colorOnSurfaceVariant">@color/vault_text_secondary_dark</item>
        <item name="colorOutline">@color/vault_outline_dark</item>
        <item name="colorOutlineVariant">@color/vault_outline_dark</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- 1. OBSIDIAN THEME -->
    <style name="Theme.CipherVault.Obsidian" parent="Theme.CipherVault">
        <item name="colorPrimary">@color/obsidian_primary</item>
        <item name="colorOnPrimary">@color/obsidian_on_primary</item>
        <item name="colorPrimaryContainer">@color/obsidian_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/obsidian_on_primary_container</item>
        <item name="colorSecondary">@color/obsidian_primary</item>
        <item name="colorOnSecondary">@color/obsidian_on_primary</item>
        <item name="colorSecondaryContainer">@color/obsidian_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/obsidian_on_primary_container</item>
    </style>

    <!-- 2. RUBY THEME -->
    <style name="Theme.CipherVault.Ruby" parent="Theme.CipherVault">
        <item name="colorPrimary">@color/ruby_primary</item>
        <item name="colorOnPrimary">@color/ruby_on_primary</item>
        <item name="colorPrimaryContainer">@color/ruby_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ruby_on_primary_container</item>
        <item name="colorSecondary">@color/ruby_primary</item>
        <item name="colorOnSecondary">@color/ruby_on_primary</item>
        <item name="colorSecondaryContainer">@color/ruby_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/ruby_on_primary_container</item>
