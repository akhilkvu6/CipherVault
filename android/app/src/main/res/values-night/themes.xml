<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application dark theme with Samsung One UI styling. -->
    <style name="Base.Theme.CipherVault" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/cv_primary</item>
        <item name="colorOnPrimary">@color/cv_on_primary</item>
        <item name="colorPrimaryContainer">@color/cv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/cv_on_primary_container</item>

        <!-- Background & Surface Colors -->
        <item name="android:windowBackground">@color/cv_background</item>
        <item name="colorSurface">@color/cv_surface</item>
        <item name="colorSurfaceVariant">@color/cv_surface_variant</item>
        <item name="colorOnSurface">@color/cv_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/cv_text_secondary</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/cv_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/cv_background</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Typography / Text Appearance defaults -->
        <item name="android:textColorPrimary">@color/cv_text_primary</item>
        <item name="android:textColorSecondary">@color/cv_text_secondary</item>
    </style>
</resources>