<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_home"
    app:startDestination="@id/dest_home">

    <!-- Home Root -->
    <fragment
        android:id="@+id/dest_home"
        android:name="com.ciphervault.app.navigation.StructuralDestinationFragment"
        android:label="Home">
        <action
            android:id="@+id/action_dest_home_to_dest_analytics"
            app:destination="@id/dest_analytics"
            app:enterAnim="@animator/nav_forward_enter"
            app:exitAnim="@animator/nav_forward_exit"
            app:popEnterAnim="@animator/nav_back_enter"
            app:popExitAnim="@animator/nav_back_exit" />
        <action
            android:id="@+id/action_dest_home_to_dest_collections"
            app:destination="@id/dest_collections"
            app:enterAnim="@animator/nav_forward_enter"
            app:exitAnim="@animator/nav_forward_exit"
            app:popEnterAnim="@animator/nav_back_enter"
            app:popExitAnim="@animator/nav_back_exit" />
        <action
            android:id="@+id/action_dest_home_to_dest_storage_category"
            app:destination="@id/dest_storage_category"
            app:enterAnim="@animator/nav_forward_enter"
            app:exitAnim="@animator/nav_forward_exit"
            app:popEnterAnim="@animator/nav_back_enter"
            app:popExitAnim="@animator/nav_back_exit" />
        <action
            android:id="@+id/action_dest_home_to_dest_security_status"
            app:destination="@id/dest_security_status"
            app:enterAnim="@animator/nav_forward_enter"
            app:exitAnim="@animator/nav_forward_exit"
            app:popEnterAnim="@animator/nav_back_enter"
            app:popExitAnim="@animator/nav_back_exit" />
    </fragment>

    <!-- Child Destinations -->
    <fragment
        android:id="@+id/dest_analytics"
        android:name="com.ciphervault.app.navigation.StructuralDestinationFragment"
        android:label="Analytics" />

    <fragment
        android:id="@+id/dest_collections"
        android:name="com.ciphervault.app.navigation.StructuralDestinationFragment"
        android:label="Collections" />

    <fragment
        android:id="@+id/dest_storage_category"
        android:name="com.ciphervault.app.navigation.StructuralDestinationFragment"
        android:label="Storage Category" />

    <fragment
        android:id="@+id/dest_security_status"
        android:name="com.ciphervault.app.navigation.StructuralDestinationFragment"
        android:label="Security Status" />

</navigation>
