<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="@color/cv_surface"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_progress_rounded"
        android:backgroundTint="@color/cv_border" />

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/tvDownloadTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Download file"
        android:textSize="20sp"
        android:fontFamily="@font/source_serif_4"
        android:textColor="@color/cv_text_primary" />

    <TextView
        android:id="@+id/tvDownloadSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Choose how you want to download this file."
        android:textColor="@color/cv_text_secondary"
        android:textSize="13sp" />

    <!-- Primary Action: Decrypt & Download -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnOptionDecrypt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/cv_primary"
        app:cardBackgroundColor="@color/cv_card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lucide_unlock"
                app:tint="@color/cv_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Decrypt &amp; download"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/cv_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Normal usable file ready to view"
                    android:textSize="12sp"
                    android:textColor="@color/cv_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lucide_chevron_right"
                app:tint="@color/cv_text_tertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Secondary Action: Download Encrypted -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnOptionEncrypted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/cv_border"
        app:cardBackgroundColor="@color/cv_card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lucide_lock"
                app:tint="@color/cv_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download encrypted"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/cv_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Original encrypted vault file"
                    android:textSize="12sp"
                    android:textColor="@color/cv_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lucide_chevron_right"
                app:tint="@color/cv_text_tertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel"
        android:textColor="@color/cv_text_secondary"
        app:cornerRadius="14dp"
        app:backgroundTint="@color/cv_surface_variant" />

</LinearLayout>
