<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:padding="@dimen/cv_spacing_l">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File Details"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:layout_marginBottom="@dimen/cv_spacing_m" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filename"
        android:textColor="?android:attr/textColorSecondary"
        android:textAppearance="?attr/textAppearanceBodySmall" />
    <TextView
        android:id="@+id/tvDetailFilename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_marginBottom="@dimen/cv_spacing_s"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Size"
        android:textColor="?android:attr/textColorSecondary"
        android:textAppearance="?attr/textAppearanceBodySmall" />
    <TextView
        android:id="@+id/tvDetailSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_marginBottom="@dimen/cv_spacing_s"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Type &amp; MIME"
        android:textColor="?android:attr/textColorSecondary"
        android:textAppearance="?attr/textAppearanceBodySmall" />
    <TextView
        android:id="@+id/tvDetailType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_marginBottom="@dimen/cv_spacing_s"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Encryption"
        android:textColor="?android:attr/textColorSecondary"
        android:textAppearance="?attr/textAppearanceBodySmall" />
    <TextView
        android:id="@+id/tvDetailEncryption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AES-256-GCM"
        android:layout_marginBottom="@dimen/cv_spacing_s"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHA-256"
        android:textColor="?android:attr/textColorSecondary"
        android:textAppearance="?attr/textAppearanceBodySmall" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/cv_spacing_m">
        <TextView
            android:id="@+id/tvDetailHash"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="-"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall" />
        <ImageButton
            android:id="@+id/btnCopyHash"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="?android:attr/textColorPrimary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close" />
</LinearLayout>