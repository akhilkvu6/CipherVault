<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarViewer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarViewer"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_lucide_x"
            app:navigationIconTint="@android:color/white"
            app:title="File Viewer"
            app:titleTextColor="@android:color/white">

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Decryption Loading Overlay -->
        <LinearLayout
            android:id="@+id/layoutDecrypting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:indicatorSize="44dp"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="Decrypting AES-256-GCM..."
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Streaming 16 KB chunks &amp; verifying GCM tag"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Image Viewer -->
        <ImageView
            android:id="@+id/ivViewerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Decrypted image"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Media3 ExoPlayer Video/Audio View -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <!-- Text / Document Viewer -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewerText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvViewerTextContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

        </androidx.core.widget.NestedScrollView>

        <!-- Generic / Non-previewable File Card -->
        <LinearLayout
            android:id="@+id/layoutViewerGeneric"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivGenericFileIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="File icon"
                    android:src="@drawable/ic_lucide_database"
                    app:tint="?attr/colorOnSecondaryContainer" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvGenericFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="sample_document.docx" />

            <TextView
                android:id="@+id/tvGenericFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="2.4 MB • application/msword" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenExternal"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:text="Open with External App"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_lucide_arrow_right" />

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
