<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manageStorageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/cv_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Manage storage"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/cv_spacing_l">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E2E7">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/cv_spacing_l"
                        android:paddingBottom="@dimen/cv_spacing_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cv_spacing_l"
                            android:layout_marginEnd="@dimen/cv_spacing_l"
                            android:text="CipherVault storage"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginStart="@dimen/cv_spacing_l"
                            android:layout_marginEnd="@dimen/cv_spacing_l"
                            android:layout_marginTop="@dimen/cv_spacing_s">
                            
                            <TextView
                                android:id="@+id/tvStoragePercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="#1D1D1F" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="6dp"
                                android:text="used"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                            <TextView
                                android:id="@+id/tvStorageTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="0 GB / 10 GB"
                                android:textColor="#6E6E73"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginStart="@dimen/cv_spacing_l"
                            android:layout_marginEnd="@dimen/cv_spacing_l"
                            android:layout_marginTop="@dimen/cv_spacing_m"
                            android:background="@drawable/bg_progress_rounded"
                            android:orientation="horizontal"
                            android:clipToOutline="true">
                            <!-- Dynamic views added here -->
                        </LinearLayout>
                            
                        <LinearLayout
                            android:id="@+id/llCategories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/cv_spacing_l"
                            android:layout_marginEnd="@dimen/cv_spacing_l"
                            android:layout_marginTop="@dimen/cv_spacing_l">
                            <!-- Dynamically populated categories -->
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/cv_spacing_m"
                            android:background="#E5E5EA" />

                        <LinearLayout
                            android:id="@+id/llLargeFiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="@dimen/cv_spacing_m"
                            android:paddingBottom="0dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_lucide_file"
                                    app:tint="#6E6E73" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Large files"
                                    android:textColor="#6E6E73"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>
                            
                            <TextView
                                android:id="@+id/tvLargeFilesSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Loading..."
                                android:textStyle="bold"
                                android:textColor="#1D1D1F"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
