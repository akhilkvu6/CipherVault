<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/cv_spacing_xl"
        android:paddingTop="@dimen/cv_spacing_s"
        android:paddingBottom="@dimen/cv_spacing_xl">

        <!-- Top visual container holding the dynamic animation -->
        <FrameLayout
            android:id="@+id/visualContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/cv_visual_height"
            android:layout_marginTop="@dimen/cv_spacing_xs"
            android:contentDescription="@string/cd_onboarding_visual"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Category / Feature Badge Pill -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cv_spacing_l"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="@dimen/cv_spacing_s"
            android:paddingVertical="@dimen/cv_spacing_xxs"
            android:textColor="@color/cv_badge_text"
            android:textSize="@dimen/cv_text_size_badge"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/visualContainer" />

        <!-- Large One UI-style Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cv_spacing_s"
            android:textColor="@color/cv_text_primary"
            android:textSize="@dimen/cv_text_size_title"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBadge" />

        <!-- Descriptive Body Text -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cv_spacing_s"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/cv_text_secondary"
            android:textSize="@dimen/cv_text_size_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Optional Pills Container (Horizontal Flow / LinearLayout) -->
        <LinearLayout
            android:id="@+id/pillsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cv_spacing_m"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription" />

        <!-- Optional Expandable "How it works" / "Why SHA-256" Grouped Surface -->
        <LinearLayout
            android:id="@+id/expandableCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cv_spacing_m"
            android:background="@drawable/bg_grouped_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="@dimen/cv_spacing_m"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pillsContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvExpandableTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/cv_text_primary"
                    android:textSize="@dimen/cv_text_size_body"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivExpandIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/cd_expand_section"
                    android:src="@drawable/ic_expand_more" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExpandableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cv_spacing_xs"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/cv_text_secondary"
                android:textSize="@dimen/cv_text_size_caption"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
