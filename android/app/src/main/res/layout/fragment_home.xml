<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cv_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="110dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cv_spacing_xl"
            android:paddingTop="@dimen/cv_spacing_xxl">

            <!-- Error Banner -->
            <LinearLayout
                android:id="@+id/llErrorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cv_spacing_m"
                android:background="@drawable/bg_grouped_card"
                android:backgroundTint="#FDF2F2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/cv_spacing_m"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="#D32F2F" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cv_spacing_s"
                    android:layout_weight="1"
                    android:text="Couldn't connect to CipherVault. Check connection."
                    android:textColor="#D32F2F"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.CipherVault.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="64dp"
                    android:paddingHorizontal="10dp"
                    android:text="Retry"
                    android:textColor="#D32F2F"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 1. HEADER (Greeting + User + Profile) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/source_serif_4"
                        android:text="Good morning"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Your private vault is secure."
                        android:textColor="@color/cv_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Profile letter avatar button -->
                <TextView
                    android:id="@+id/tvProfileAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/cv_primary_container"
                    android:clickable="true"
                    android:contentDescription="Profile"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="@color/cv_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. STORAGE OVERVIEW (Samsung One UI Inspired) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cv_spacing_xl"
                android:layout_marginBottom="@dimen/cv_spacing_xs"
                android:letterSpacing="0.08"
                android:text="STORAGE OVERVIEW"
                android:textColor="@color/cv_text_tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cvStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grouped_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/cv_spacing_l">

                <!-- Top Row: Usage text (Left) + Donut Ring (Right) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStorageTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CipherVault Storage"
                            android:textColor="@color/cv_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvStorageUsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0.0 GB"
                            android:textColor="@color/cv_text_primary"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStorageTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="of 10.0 GB total"
                            android:textColor="@color/cv_text_tertiary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Circular Progress Ring -->
                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/cpStorageRing"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:layout_gravity="center"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/cv_primary"
                            app:indicatorSize="76dp"
                            app:trackColor="@color/cv_divider"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                        <TextView
                            android:id="@+id/tvStoragePercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/cv_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="0%" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Linear Bar -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cv_spacing_m"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/cv_primary"
                    app:trackColor="@color/cv_divider"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <!-- Detail Metrics (Monochrome / Consistent) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cv_spacing_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Used -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="@color/cv_primary" />

                        <TextView
                            android:id="@+id/tvStorageUsedDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Used: 0 GB"
                            android:textColor="@color/cv_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Available -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="@color/cv_security_success" />

                        <TextView
                            android:id="@+id/tvStorageAvailable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Free: 10 GB"
                            android:textColor="@color/cv_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Total files -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="@color/cv_text_tertiary" />

                        <TextView
                            android:id="@+id/tvStorageFileCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="0 files"
                            android:textColor="@color/cv_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Inset Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/cv_spacing_m"
                    android:background="@color/cv_divider" />

                <!-- Manage Storage shortcut row -->
                <LinearLayout
                    android:id="@+id/btnQuickManage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lucide_hard_drive"
                        app:tint="@color/cv_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cv_spacing_s"
                        android:layout_weight="1"
                        android:text="Manage Storage &amp; Analytics"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lucide_chevron_right"
                        app:tint="@color/cv_text_tertiary" />
                </LinearLayout>

            </LinearLayout>

            <!-- 3. QUICK ACTIONS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cv_spacing_xl"
                android:layout_marginBottom="@dimen/cv_spacing_xs"
                android:letterSpacing="0.08"
                android:text="QUICK ACTIONS"
                android:textColor="@color/cv_text_tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grouped_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/cv_spacing_m">

                <!-- 1. Upload -->
                <LinearLayout
                    android:id="@+id/btnQuickUpload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cv_spacing_xs">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="12dp"
                        android:src="@drawable/ic_lucide_upload"
                        app:tint="@color/cv_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Upload"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. My Files -->
                <LinearLayout
                    android:id="@+id/btnQuickFiles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cv_spacing_xs">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="12dp"
                        android:src="@drawable/ic_nav_files"
                        app:tint="@color/cv_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="My Files"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. Search -->
                <LinearLayout
                    android:id="@+id/btnQuickSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cv_spacing_xs">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="12dp"
                        android:src="@drawable/ic_lucide_search"
                        app:tint="@color/cv_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Search"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. Transfers -->
                <LinearLayout
                    android:id="@+id/btnQuickTransfers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cv_spacing_xs">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_circle"
                        android:padding="12dp"
                        android:src="@drawable/ic_nav_transfers"
                        app:tint="@color/cv_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Transfers"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- 4. RECENT FILES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cv_spacing_xl"
                android:layout_marginBottom="@dimen/cv_spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="RECENT FILES"
                    android:textColor="@color/cv_text_tertiary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeeAllRecent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="See all &gt;"
                    android:textColor="@color/cv_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardRecentFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grouped_card"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/llEmptyFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/cv_spacing_xl"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_lucide_file"
                        app:tint="@color/cv_text_tertiary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cv_spacing_s"
                        android:text="No files yet"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Upload your first file to start using your private vault."
                        android:textColor="@color/cv_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyUpload"
                        style="@style/Widget.CipherVault.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="@dimen/cv_spacing_m"
                        android:minWidth="130dp"
                        android:text="Upload file"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 5. RECENT ACTIVITY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cv_spacing_xl"
                android:layout_marginBottom="@dimen/cv_spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="RECENT ACTIVITY"
                    android:textColor="@color/cv_text_tertiary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeeAllActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="See all &gt;"
                    android:textColor="@color/cv_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardRecentActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grouped_card"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty state for activity -->
                <TextView
                    android:id="@+id/tvEmptyActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/cv_spacing_m"
                    android:text="No recent vault activity recorded."
                    android:textColor="@color/cv_text_tertiary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- 6. VAULT HEALTH -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cv_spacing_xl"
                android:layout_marginBottom="@dimen/cv_spacing_xs"
                android:letterSpacing="0.08"
                android:text="VAULT HEALTH"
                android:textColor="@color/cv_text_tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnVaultHealthCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grouped_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/cv_spacing_m">

                <!-- Row 1: Server Connection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/dotHealthServer"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/cv_text_tertiary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Server connection"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHealthServerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking..."
                        android:textColor="@color/cv_text_tertiary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnectServer"
                        style="@style/Widget.CipherVault.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="64dp"
                        android:paddingHorizontal="10dp"
                        android:text="Connect"
                        android:textColor="@color/cv_primary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/cv_divider" />

                <!-- Row 2: Encryption -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/dotHealthEncryption"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/cv_security_success" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Encryption status"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHealthEncryptionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AES-256 Active"
                        android:textColor="@color/cv_security_success"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/cv_divider" />

                <!-- Row 3: Authentication -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <View
                        android:id="@+id/dotHealthAuth"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/cv_security_success" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Authentication"
                        android:textColor="@color/cv_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHealthAuthStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Valid"
                        android:textColor="@color/cv_security_success"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
