<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/cv_spacing_m"
    android:paddingVertical="@dimen/cv_spacing_s">

    <ImageView
        android:id="@+id/ivActivityIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_thumbnail_rounded"
        android:padding="9dp"
        android:src="@drawable/ic_lucide_upload"
        app:tint="@color/cv_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cv_spacing_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActivitySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cv_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActivityTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cv_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
