<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Captured Photo Preview (Hidden initially) -->
    <ImageView
        android:id="@+id/ivCapturedPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Captured photo preview"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Top Overlay Controls -->
    <LinearLayout
        android:id="@+id/layoutTopControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnCloseCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="Close camera"
            android:src="@drawable/ic_lucide_x"
            app:tint="@android:color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnFlashToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="Toggle Flash"
            android:src="@drawable/ic_lucide_zap"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="Switch camera"
            android:src="@drawable/ic_lucide_switch_camera"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- Bottom Capture Controls -->
    <LinearLayout
        android:id="@+id/layoutCaptureControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.03"
            android:text="Tap to capture photo for vault encryption"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCapturePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Capture Photo"
            app:backgroundTint="@android:color/white"
            app:fabCustomSize="72dp"
            app:maxImageSize="32dp"
            app:rippleColor="?attr/colorPrimary"
            app:srcCompat="@drawable/ic_lucide_camera"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

    <!-- Bottom Post-Capture Action Bar (Retake / Keep) -->
    <LinearLayout
        android:id="@+id/layoutPostCaptureControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetake"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Retake"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="#66000000"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_lucide_x"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeepPhoto"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Stage to Vault"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_lucide_check_circle"
            app:iconTint="?attr/colorOnPrimary" />

    </LinearLayout>

</FrameLayout>
