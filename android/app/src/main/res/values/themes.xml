<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ================================================================= -->
    <!-- CIPHERVAULT UNIFIED MATERIAL 3 THEME (LIGHT)                      -->
    <!-- Warm Brown / Taupe / Caramel / Cream Security Identity            -->
    <!-- ================================================================= -->
    <style name="Theme.CipherVault" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Accent Colors -->
        <item name="colorPrimary">@color/cv_light_primary_brown</item>
        <item name="colorOnPrimary">@color/cv_light_surface</item>
        <item name="colorPrimaryContainer">@color/cv_light_surface_container</item>
        <item name="colorOnPrimaryContainer">@color/cv_light_text_primary</item>

        <item name="colorSecondary">@color/cv_light_caramel</item>
        <item name="colorOnSecondary">@color/cv_light_surface</item>
        <item name="colorSecondaryContainer">@color/cv_light_surface_elevated</item>
        <item name="colorOnSecondaryContainer">@color/cv_light_text_primary</item>

        <!-- Surface Roles -->
        <item name="android:colorBackground">@color/cv_light_bg</item>
        <item name="colorSurface">@color/cv_light_bg</item>
        <item name="colorOnSurface">@color/cv_light_text_primary</item>
        <item name="colorSurfaceVariant">@color/cv_light_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/cv_light_text_secondary</item>
        <item name="colorSurfaceContainer">@color/cv_light_surface</item>
        <item name="colorSurfaceContainerLow">@color/cv_light_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/cv_light_surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/cv_light_surface_container</item>

        <!-- Outlines & Borders -->
        <item name="colorOutline">@color/cv_light_outline</item>
        <item name="colorOutlineVariant">@color/cv_light_outline_variant</item>

        <!-- Semantic Statuses -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/status_error_container</item>

        <!-- System Bars (Edge-to-Edge) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Material 3 Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CipherVault.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CipherVault.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CipherVault.Large</item>
        <item name="bottomSheetDialogTheme">@style/Theme.CipherVault.BottomSheetDialog</item>
    </style>

    <!-- Corner Radius Geometry Tokens -->
    <style name="ShapeAppearance.CipherVault.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.CipherVault.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.CipherVault.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.CipherVault.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.CipherVault.BottomSheet" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="Theme.CipherVault.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.CipherVault.BottomSheet</item>
    </style>

    <style name="Widget.CipherVault.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.CipherVault.BottomSheet</item>
        <item name="backgroundTint">@color/cv_light_surface</item>
    </style>
</resources>