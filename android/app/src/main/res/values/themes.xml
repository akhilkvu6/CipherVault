<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CipherVault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cv_primary</item>
        <item name="colorOnPrimary">@color/cv_on_primary</item>
        <item name="colorPrimaryContainer">@color/cv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/cv_on_primary_container</item>

        <item name="android:windowBackground">@color/cv_background</item>
        <item name="colorSurface">@color/cv_surface</item>
        <item name="colorSurfaceVariant">@color/cv_surface_variant</item>
        <item name="colorOnSurface">@color/cv_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/cv_text_secondary</item>

        <item name="android:statusBarColor">@color/cv_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cv_background</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:textColorPrimary">@color/cv_text_primary</item>
        <item name="android:textColorSecondary">@color/cv_text_secondary</item>
        <item name="android:fontFamily">@font/nunito_sans</item>
        <item name="fontFamily">@font/nunito_sans</item>
        
        <!-- Global Component Overrides -->
        <item name="materialButtonStyle">@style/Widget.CipherVault.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.CipherVault.Card</item>
        
    </style>

    <style name="Theme.CipherVault" parent="Base.Theme.CipherVault" />

    <style name="Theme.CipherVault.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cv_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CipherVault</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.CipherVault.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cv_primary</item>
        <item name="android:textColor">@color/cv_on_primary</item>
        <item name="cornerRadius">@dimen/cv_corner_radius_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">@dimen/cv_text_size_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.CipherVault.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/cv_text_secondary</item>
        <item name="cornerRadius">@dimen/cv_corner_radius_button</item>
        <item name="android:textSize">@dimen/cv_text_size_button</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    
    <!-- Card Styles -->
    <style name="Widget.CipherVault.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/cv_surface</item>
        <item name="cardCornerRadius">@dimen/cv_corner_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    
    <!-- Nav Indicator Style -->
    <style name="ShapeAppearance.CipherVault.NavIndicator" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.CipherVault.RoundedRect" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Widget.CipherVault.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cv_nav_indicator</item>
        <item name="android:width">56dp</item>
        <item name="android:height">34dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CipherVault.NavIndicator</item>
    </style>

    <style name="Theme.CipherVault.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.CipherVault.BottomSheet</item>
    </style>

    <style name="Widget.CipherVault.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/cv_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CipherVault.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.CipherVault.BottomSheet" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>


