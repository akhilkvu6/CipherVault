<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ================================================================= -->
    <!-- CIPHERVAULT UNIFIED MATERIAL 3 THEME (LIGHT)                      -->
    <!-- Warm Brown / Taupe / Caramel / Cream Security Identity            -->
    <!-- ================================================================= -->
    <style name="Theme.CipherVault" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Accent Colors -->
        <item name="colorPrimary">@color/cv_light_primary_brown</item>
        <item name="colorOnPrimary">@color/cv_light_surface</item>
        <item name="colorPrimaryContainer">@color/cv_light_surface_container</item>
        <item name="colorOnPrimaryContainer">@color/cv_light_text_primary</item>

        <item name="colorSecondary">@color/cv_light_caramel</item>
        <item name="colorOnSecondary">@color/cv_light_surface</item>
        <item name="colorSecondaryContainer">@color/cv_light_surface_elevated</item>
        <item name="colorOnSecondaryContainer">@color/cv_light_text_primary</item>

        <!-- Surface Roles -->
        <item name="android:colorBackground">@color/cv_light_bg</item>
        <item name="colorSurface">@color/cv_light_bg</item>
        <item name="colorOnSurface">@color/cv_light_text_primary</item>
        <item name="colorSurfaceVariant">@color/cv_light_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/cv_light_text_secondary</item>
        <item name="colorSurfaceContainer">@color/cv_light_surface</item>
        <item name="colorSurfaceContainerLow">@color/cv_light_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/cv_light_surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/cv_light_surface_container</item>

        <!-- Outlines & Borders -->
        <item name="colorOutline">@color/cv_light_outline</item>
        <item name="colorOutlineVariant">@color/cv_light_outline_variant</item>

        <!-- Semantic Statuses -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/status_error_container</item>

        <!-- System Bars (Edge-to-Edge) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Material 3 Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CipherVault.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CipherVault.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CipherVault.Large</item>
        <item name="bottomSheetDialogTheme">@style/Theme.CipherVault.BottomSheetDialog</item>
    </style>

    <!-- Corner Radius Geometry Tokens -->
    <style name="ShapeAppearance.CipherVault.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.CipherVault.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.CipherVault.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">26dp</item>
    </style>

    <style name="ShapeAppearance.CipherVault.BottomSheet" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="Theme.CipherVault.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.CipherVault.BottomSheet</item>
    </style>

    <style name="Widget.CipherVault.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.CipherVault.BottomSheet</item>
        <item name="backgroundTint">@color/cv_light_surface</item>
    </style>

    <!-- Sleek Rounded Navigation Indicator -->
    <style name="CipherVaultActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">48dp</item>
        <item name="android:height">28dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CipherVault.Indicator</item>
    </style>

    <style name="ShapeAppearance.CipherVault.Indicator" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Typography Styles for Navigation Bar Labels -->
    <style name="CipherVaultNavTextActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="CipherVaultNavTextInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ================================================================= -->
    <!-- CIPHERVAULT AMOLED THEME (PURE BLACK / WHITE / GRAYSCALE)         -->
    <!-- Strict Pure Black Surface Architecture, Restrained Grayscale      -->
    <!-- ================================================================= -->
    <style name="Theme.CipherVault.Amoled" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Accent Colors -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#000000</item>

        <item name="colorSecondary">#BDBDBD</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#1A1A1A</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>

        <!-- Surface Roles: Pure Black -->
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#121212</item>
        <item name="colorOnSurfaceVariant">#BDBDBD</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerHigh">#121212</item>
        <item name="colorSurfaceContainerHighest">#1A1A1A</item>

        <!-- Outlines & Borders: Restrained Grayscale -->
        <item name="colorOutline">#2A2A2A</item>
        <item name="colorOutlineVariant">#2A2A2A</item>

        <!-- Semantic Statuses: Red reserved strictly for error/delete -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#2A1212</item>

        <!-- System Bars (Edge-to-Edge Pure Black) -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Material 3 Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CipherVault.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CipherVault.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CipherVault.Large</item>
        <item name="bottomSheetDialogTheme">@style/Theme.CipherVault.BottomSheetDialog.Amoled</item>
    </style>

    <style name="Theme.CipherVault.BottomSheetDialog.Amoled" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.CipherVault.BottomSheet.Amoled</item>
    </style>

    <style name="Widget.CipherVault.BottomSheet.Amoled" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.CipherVault.BottomSheet</item>
        <item name="backgroundTint">#000000</item>
    </style>
</resources>