<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".CipherVaultApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CipherVault"
        android:usesCleartextTraffic="true">

        <!-- 1. Splash Activity (Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CipherVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Onboarding Activity (Protected Approved Design) -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:theme="@style/Theme.CipherVault.Onboarding"
            android:exported="true" />

        <!-- 3. Connection Activity -->
        <activity
            android:name=".ConnectionActivity"
            android:exported="true" />

        <!-- 3a. QR Scan Activity -->
        <activity
            android:name=".QrScanActivity"
            android:exported="true" />

        <!-- 4. Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Signup Activity -->
        <activity
            android:name=".SignupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. App Lock Activity -->
        <activity
            android:name=".AppLockActivity"
            android:exported="true" />

        <!-- 7. Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Upload Staging Activity -->
        <activity
            android:name=".UploadStagingActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 9. Camera Activity -->
        <activity
            android:name=".CameraActivity"
            android:exported="true" />

        <!-- 10. File Viewer Activity -->
        <activity
            android:name=".FileViewerActivity"
            android:exported="true" />

        <!-- 11. Dedicated Metadata Search Activity -->
        <activity
            android:name=".MetadataSearchActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 12. Design System Showcase Activity -->
        <activity
            android:name=".UiShowcaseActivity"
            android:exported="true" />

        <!-- 13. About Activity -->
        <activity
            android:name=".AboutActivity"
            android:exported="true" />

        <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Transfer Foreground Service -->
        <service
            android:name=".transfer.TransferService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>